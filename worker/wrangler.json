{
    "name": "explain-share",
    "main": "src/index.ts",
    "compatibility_date": "2026-10-01",
    "workers_dev": false,
    "routes": [{"pattern": "share.tabularis.dev", "custom_domain": true}],
    "r2_buckets": [{"binding": "PLANS", "bucket_name": "explain-shared-plans"}],
    "ratelimits": [{"name": "SHARE_LIMITER", "namespace_id": "1001", "simple": {"limit": 10, "period": 60}}],
    "vars": {"ALLOWED_ORIGIN": "https://explain.tabularis.dev"}
}
